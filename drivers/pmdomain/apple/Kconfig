if ARCH_APPLE || COMPILE_TEST

config APPLE_PMGR_PWRSTATE
	bool "Apple SoC PMGR power state control"
	depends on PM
	select REGMAP
	select MFD_SYSCON
	select PM_GENERIC_DOMAINS
	select RESET_CONTROLLER
	help
	  The PMGR block in Apple SoCs provides high-level power state
	  controls for SoC devices. This driver manages them through the
	  generic power domain framework, and also provides reset support.

config APPLE_PMGR_PSD
	bool "Apple T8152 PSD service slot power domains"
	default ARCH_APPLE
	depends on OF
	depends on PM
	select PM_GENERIC_DOMAINS
	help
	  The M6 (T8152) power state director gates the ATC USB blocks behind a
	  per-port service slot request on top of the PMGR power states. This
	  driver exposes each slot as a power domain whose parents are the PMGR
	  domains, so consumers (the USB DARTs and controllers) power both in order.

config APPLE_PMP_REPORT
	bool "Apple PMP report control"
	depends on OF
	depends on PM
	select PM_GENERIC_DOMAINS

endif
