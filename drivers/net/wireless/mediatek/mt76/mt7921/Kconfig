config MT7921_COMMON
	tristate
	select MT792x_LIB
	select WANT_DEV_COREDUMP

config MT7921E
	tristate "MediaTek MT7921E (PCIe) support"
	select MT7921_COMMON
	depends on MAC80211
	depends on PCI
	help
	  This adds support for MT7921E 802.11ax 2x2:2SS wireless devices.

	  To compile this driver as a module, choose M here.

config MT7921_J700_MCU_LAB
	bool "J700 MT7932 MCU conformance checkpoint"
	depends on MT7921E = y || MT7921E = MT7921_COMMON
	default n
	help
	  Development-only misc-device bridge for measured J700 firmware command
	  conformance. The kernel retains PCIe, WFDMA, TXD, sequence, IRQ, RX and
	  reset ownership. It can stop early probe while an external conformance
	  executor supplies measured firmware commands. Production kernels should
	  leave this disabled.

config MT7921S
	tristate "MediaTek MT7921S (SDIO) support"
	select MT76_SDIO
	select MT7921_COMMON
	depends on MAC80211
	depends on MMC
	help
	  This adds support for MT7921S 802.11ax 2x2:2SS wireless devices.

	  To compile this driver as a module, choose M here.

config MT7921U
	tristate "MediaTek MT7921U (USB) support"
	select MT792x_USB
	select MT7921_COMMON
	depends on MAC80211
	depends on USB
	help
	  This adds support for MT7921U 802.11ax 2x2:2SS wireless devices.

	  To compile this driver as a module, choose M here.
