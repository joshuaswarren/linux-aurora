# J700 (MacBook Neo, T8140) integration kernel: merge after defconfig and asahi.config:
#   make ARCH=arm64 LLVM=1 defconfig asahi.config j700.config
# Reproduces the hardware-qualified hybrid/daily-next2 config (7.1.12-aurora-daily-next2+)
# plus THERMAL_WRITABLE_TRIPS, the ANE bring-up modules and the PMU RTC alarm.
# Private linux-aurora tree: enables dirty/TAINTED hybrid drivers (MT7932 fullmac, SEP, H17P DCP, G17P).
CONFIG_APPLE_ANE_BRINGUP=m
CONFIG_APPLE_DART=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_APPLE_PMP=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_TUNABLE=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_AX88796B_PHY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BTRFS_FS=y
