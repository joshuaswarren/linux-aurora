# Fragment for an on-disk distro root on the MacBook Neo (J700): merge after defconfig + asahi.config + the Neo fragment.
# On-disk Omarchy root + distro requirements, layered over neo.config
CONFIG_LOCALVERSION="-aurora-neo-disk"
CONFIG_MODULES=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DRM_ASAHI=m
CONFIG_DRM_APPLE=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=m
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=m
CONFIG_CRYPTO_HMAC=m
CONFIG_CRYPTO_CMAC=m
CONFIG_CRYPTO_MD5=m
CONFIG_CRYPTO_SHA1=m
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=m
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_OVERLAY_FS=m
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_FIB_RULES=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,bpf"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUSE_FS=m
CONFIG_SQUASHFS=m
CONFIG_ZRAM=m
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_INPUT_EVDEV=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_GENERIC=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_MACSMC_POWER=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
CONFIG_APPLE_SART=y
CONFIG_NVME_APPLE=y
CONFIG_I2C_APPLE=y
CONFIG_SPI_APPLE=y
CONFIG_APPLE_RTKIT_HELPER=y
# Cleanroom MT7932 Wi-Fi (ported from cleanroom-linux) instead of aurora mt7921e
CONFIG_MT7932_FULLMAC=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_J700_RADIO_OVERLAY=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
# CONFIG_MT7921E is not set
CONFIG_USB_IPHETH=m
CONFIG_USB_NET_RNDIS_HOST=m
# Bluetooth via cleanroom MT7932 PCIe driver (firmware to be extracted)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_MTK7932_PCIE=y
# CONFIG_BT_HCIMT79XX_PCIE is not set
# Desktop/USB-C parity with the cleanroom J700 config
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_DWC3_HOST=y
CONFIG_TYPEC=y
CONFIG_TYPEC_SN201202X=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CMAC=y

# FIDO/U2F keys and other raw HID users
CONFIG_HIDRAW=y

CONFIG_PWM_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y

# Audio, camera, cpufreq/thermal (j700 as of 2026-09-18)
CONFIG_PWM_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_APPLE_SMC_CPU_THERMAL=y
CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=m
CONFIG_APPLE_AOP=m
CONFIG_SND_SOC_APPLE_MACAUDIO=m
CONFIG_SND_SOC_APPLE_MCA=m
CONFIG_SND_SOC_CS42L83=m
CONFIG_SND_SOC_CS42L42_CORE=m
CONFIG_SND_SOC_MAX98357A=m
CONFIG_APPLE_ADMAC=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_APPLE_ISP=m
CONFIG_CHARGER_MACSMC=m
