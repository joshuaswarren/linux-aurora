/*
 * MacBook Neo (J700) with the MT7932 radio described statically.
 *
 * Same content as drivers/of/j700_radio.dtso, folded into the board tree so a
 * loader that boots Linux directly (no runtime overlay) gets working Wi-Fi.
 * local-mac-address is per machine; no wifi0 alias is added so the in-kernel
 * j700_radio overlay driver stays inert.
 */
#include "t8140-j700.dts"

&{/soc} {
	piodma_radio: piodma@390030000 {
		compatible = "apple,t8140-pcie-piodma";
		reg = <0x3 0x90030000 0x0 0x4000>,
		      <0x3 0x90034000 0x0 0x4000>,
		      <0x3 0x90038000 0x0 0x4000>;
		reg-names = "engine", "irq-aggregator", "fabric";
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 0x4b7 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&{/soc/iommu@390000000} 17>;
		apple,iova-address-bits = <36>;
		apple,piodma-base-addresses = <0x1c 0xb0000000>, <0xb 0xc0000000>, <0xb 0x80000000>;
		apple,piodma-aperture-sizes = <0x0 0x10000000>, <0x0 0x20000000>, <0x0 0x40000000>;
	};
};

&{/soc/iommu@390000000} {
	#iommu-cells = <1>;
	apple,force-available;
};

&{/soc/pcie@1cb0000000} {
	iommu-map = <0x100 &{/soc/iommu@390000000} 0x1 0x1>,
		    <0x101 &{/soc/iommu@390000000} 0x2 0x1>;
	iommu-map-mask = <0xffff>;
	apple,valid-functions = <0x3>;
	apple,endpoint-iova-address-bits = <32>;
	apple,piodma = <&piodma_radio>;
	dma-coherent;

	pci@0,0 {
		wifi@0,0 {
			compatible = "pci14c3,7932";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			local-mac-address = [5c 13 ac 09 b2 49];
		};
	};
};

/*
 * PMU NVMEM (power-off and RTC). From this machine's ADT (evidence/adt/): pmu-main@E on nub-spmi0,
 * compatible "pmu,spmi"/"pmu,baku", info-leg_scrpad 0xf700, info-rtc 0xf802. Without shutdown_flag the
 * SMC restarts the machine after 'off1'; without rtc_offset there is no RTC. Not compile-tested in the
 * kernel tree yet; the same nodes are verified on hardware via kernel/dtb/*-pmu-rtc.dts (decompiled form).
 */
&{/soc} {
	nub_spmi0: spmi@308714000 {
		compatible = "apple,t8140-spmi", "apple,t8103-spmi";
		reg = <0x3 0x08714000 0x0 0x100>;
		#address-cells = <2>;
		#size-cells = <0>;
		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 487 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_nub_spmi0>;

		pmic@e {
			compatible = "apple,baku-pmic", "apple,spmi-nvmem";
			reg = <0xe SPMI_USID>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				boot_stage: boot-stage@f701 { reg = <0xf701 0x1>; };
				boot_error_count: boot-error-count@f702,0 { reg = <0xf702 0x1>; bits = <0 4>; };
				panic_count: panic-count@f702,4 { reg = <0xf702 0x1>; bits = <4 4>; };
				shutdown_flag: shutdown-flag@f70f,3 { reg = <0xf70f 0x1>; bits = <3 1>; };
				/* macOS: legacy scratchpad +4, 64-bit seconds; 0xf802 is the 65536 Hz counter itself */
				rtc_offset: rtc-offset@f704 { reg = <0xf704 0x8>; };
			};
		};
	};
};

&{/soc/smc@30c600000} {
	reboot {
		nvmem-cells = <&shutdown_flag>, <&boot_stage>, <&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage", "boot_error_count", "panic_count";
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
		apple,rtc-offset-seconds;
	};
};
