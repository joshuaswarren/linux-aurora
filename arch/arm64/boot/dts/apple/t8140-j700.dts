// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * Apple MacBook Neo
 *
 * target-type: J700
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8140.dtsi"
/ {
	compatible = "apple,j700", "apple,t8140", "apple,arm-platform";
	model = "Apple MacBook Neo";

	aliases {
		atcphy0 = &atcphy0;
		dcp = &dcp;
		dcp0 = &dcp;
		disp0 = &display;
		disp0_piodma = &disp0_piodma;
		serial0 = &serial0;
		keyboard = &keyboard;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		stdout-path = "serial0";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by loader */
			power-domains = <&ps_disp_cpu>;
			/* Format properties will be added by loader */
			status = "disabled";
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		/* To be filled by loader */
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x100 0 0x2 0>; /* To be filled by loader */
	};

	/* Live /arm-io/clock-frequencies entries 0x154 and 0x194. */
	clk_disp0_154: clock-disp0-154 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <300000000>;
		clock-output-names = "clk_disp0_154";
	};

	clk_disp0_194: clock-disp0-194 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <450000000>;
		clock-output-names = "clk_disp0_194";
	};
};

&dcp {
	clocks = <&clk_disp0_154>, <&clk_disp0_194>;
	clock-names = "clock-154", "clock-194";
	/* The iBoot and macOS captures both use IOMFB surface slot 0. */
	apple,iomfb-surfaces = <0>;
	status = "okay";

	panel: panel {
		compatible = "apple,panel-j700", "apple,panel";
		/* 2408x1506 at the ADT's measured 219 dpi. */
		width-mm = <279>;
		height-mm = <175>;
		/* ADT LmaxProduct is 525 in 16.16 fixed point. */
		apple,max-brightness = <525>;
	};
};

&dcp_dart {
	status = "okay";
};

&dcp_mbox {
	status = "okay";
};

&disp0_dart {
	status = "okay";
};

&dispgrt_dart {
	status = "okay";
};

/* The loader stops only the ASC CPU and leaves the display domain active. */
&ps_disp_cpu {
	apple,always-on;
};

&display {
	status = "okay";
};

&framebuffer0 {
	panel = <&panel>;
	post-init-providers = <&panel>;
};

/*
 * Phase-1 wireless inventory only.  The exact register windows, IRQs, port
 * count, MSI range and PERST GPIO come from the live J700 ADT captured as
 * neo-bringup/build/j700-live-adt.bin (SHA-256 f117dd865b13ce90336e5a070b333ea45b1620320be576260c0e36d5f24a2e3c).
 * m1n1 has already initialized port 0 and left its link up before Linux.
 * Describe only the generic host bridge here: no bogus Broadcom compatible,
 * no endpoint node, and no IOMMU RID/SID map until PCI enumeration proves the
 * two real functions and Phase 2 authorizes DMA.
 */
&soc {
	pcie0_dart: iommu@390000000 {
		compatible = "apple,t8140-dart", "apple,t8110-dart";
		reg = <0x3 0x90000000 0x0 0x20000>;
		#iommu-cells = <1>;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1206 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_apcie_sys_gp>;
	};

	pcie0: pcie@1cb0000000 {
		compatible = "apple,t8140-pcie", "apple,t6020-pcie";
		device_type = "pci";

		reg = <0x1c 0xb0000000 0x0 0x10000000>, /* ECAM */
		      <0x3 0x94000000 0x0 0x4000>,     /* RC */
		      <0x3 0x90028000 0x0 0x8000>,     /* port 0 */
		      <0x3 0x97020000 0x0 0x4000>;     /* port 0 PHY */
		reg-names = "config", "rc", "port0", "phy0";

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 1205 IRQ_TYPE_LEVEL_HIGH>;

		msi-controller;
		msi-parent = <&pcie0>;
		msi-ranges = <&aic AIC_IRQ 1331 IRQ_TYPE_EDGE_RISING 32>;
		power-domains = <&ps_apcie_sys_gp>;

		bus-range = <0 8>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges = <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0x0 0x20000000>,
			 <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>;

		port00: pci@0,0 {
			device_type = "pci";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			reset-gpios = <&pinctrl_ap 114 GPIO_ACTIVE_LOW>;
			/*
			 * Live J700 ADT function-reg_on is
			 * pKW8("pcIO", 0x800000, 0x80000).  Aurora IRC
			 * 92012-92014 records the hardware pass through the existing
			 * macsmc-gpio provider as pin 8.
			 */
			pwren-gpios = <&smc_gpio 8 GPIO_ACTIVE_HIGH>;
			maximum-link-speed = <2>;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;

			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
					<0 0 0 2 &port00 0 0 0 1>,
					<0 0 0 3 &port00 0 0 0 2>,
					<0 0 0 4 &port00 0 0 0 3>;
		};
	};
};

&serial0 {
	status = "okay";
};

&pinctrl_ap {
	status = "okay";
};

/*
 * 3.5 mm headphone codec (live J700 ADT /arm-io/i2c0/audio-codec-output:
 * audio-control,cs42l83 at 0x48, function-reset GPIO 103, interrupts
 * [104, 1] on gpio0).  The m1n1 hardware proof released reset through
 * GPIO 103, read ID 42/a8/3a revision B0 and heard a tone at 24 dB
 * attenuation with upstream's 6 MHz -> 12 MHz MCLK PLL tuple.
 */
&i2c0 {
	status = "okay";

	jack_codec: codec@48 {
		compatible = "cirrus,cs42l83";
		reg = <0x48>;
		reset-gpios = <&pinctrl_ap 103 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <104 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		cirrus,ts-inv = <1>;
		sound-name-prefix = "Jack";
	};
};

/*
 * Internal speaker amplifier (ADT audio-speaker audio-control,max98360,
 * function-reset GPIO 105 = the SD_MODE enable; in 25G76
 * AppleMAX98360Amp::SetMuteControl(1) drives it low, unmute high).  The
 * pin is iBoot's output-low at Linux boot and nothing raises it until a
 * driver takes sdmode-gpios: the codec driver from DAPM, or the bench
 * bounded-tone step (hrtimer-guarded, -50 dBFS ceiling).  The MAX98360
 * has no current/voltage sense, so speakersafetyd does not apply and the
 * digital ceiling lives in the machine driver.
 */
/ {
	speaker_amp: audio-amplifier {
		compatible = "maxim,max98360a";
		sdmode-gpios = <&pinctrl_ap 105 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Speaker";
	};
};

&smc_mbox {
	status = "okay";
};

/*
 * The PMU (baku, USID 0xe on nub-spmi0) carries the boot-stage / error /
 * panic counters, the shutdown flag and the RTC offset as SPMI NVMEM cells
 * (J700 ADT pmu-main@E, info-leg_scrpad 0xf700, info-rtc 0xf802; satchlj's
 * t8140-j700-radio.dts, 2026-09-18).  Without the shutdown flag every
 * poweroff turns into a reboot.  The RTC offset cell is wired but not yet
 * proven to commit: rtc-macsmc reports an invalid time until an offset
 * exists rather than 1971.
 */
&{/soc} {
	nub_spmi0: spmi@308714000 {
		compatible = "apple,t8140-spmi", "apple,t8103-spmi";
		reg = <0x3 0x08714000 0x0 0x100>;
		#address-cells = <2>;
		#size-cells = <0>;
		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 487 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_nub_spmi0>;

		pmic@e {
			compatible = "apple,baku-pmic", "apple,spmi-nvmem";
			reg = <0xe SPMI_USID>;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				boot_stage: boot-stage@f701 { reg = <0xf701 0x1>; };
				boot_error_count: boot-error-count@f702,0 { reg = <0xf702 0x1>; bits = <0 4>; };
				panic_count: panic-count@f702,4 { reg = <0xf702 0x1>; bits = <4 4>; };
				shutdown_flag: shutdown-flag@f70f,3 { reg = <0xf70f 0x1>; bits = <3 1>; };
				/* macOS: legacy scratchpad +4, 64-bit seconds; 0xf802 is the 65536 Hz counter itself */
				rtc_offset: rtc-offset@f704 { reg = <0xf704 0x8>; };
			};
		};
	};
};

&smc {
	status = "okay";

	reboot {
		compatible = "apple,smc-reboot";
		nvmem-cells = <&shutdown_flag>, <&boot_stage>, <&boot_error_count>, <&panic_count>;
		nvmem-cell-names = "shutdown_flag", "boot_stage", "boot_error_count", "panic_count";
	};

	rtc {
		compatible = "apple,smc-rtc";
		nvmem-cells = <&rtc_offset>;
		nvmem-cell-names = "rtc_offset";
		apple,rtc-offset-seconds;
	};

	/*
	 * Exactly the six SMC die temperatures the J700 CPU thermal policy samples
	 * (apple-smc-cpu-thermal, cleanroom 0d7db87fa26c): the policy refuses any
	 * other temperature channel set, so keep this list as is.
	 */
	hwmon {
		compatible = "apple,smc-hwmon";
		apple,cpu-thermal-policy;

		temperature-Te05 {
			apple,key-id = "Te05";
			label = "E-cluster Temperature 1";
		};
		temperature-Te0S {
			apple,key-id = "Te0S";
			label = "E-cluster Temperature 2";
		};
		temperature-Tp01 {
			apple,key-id = "Tp01";
			label = "P-cluster Temperature 1";
		};
		temperature-Tp05 {
			apple,key-id = "Tp05";
			label = "P-cluster Temperature 2";
		};
		temperature-Tp09 {
			apple,key-id = "Tp09";
			label = "P-cluster Temperature 3";
		};
		temperature-Tp0D {
			apple,key-id = "Tp0D";
			label = "P-cluster Temperature 4";
		};

		/*
		 * Whole-machine power telemetry (the keys hwmon-common.dtsi
		 * expects everywhere; a key the J700 SMC lacks is skipped).
		 * The backlight work reads these to show the panel power
		 * following the brightness with the machine on AC.
		 */
		power-PSTR {
			apple,key-id = "PSTR";
			label = "Total System Power";
		};
		power-PDTR {
			apple,key-id = "PDTR";
			label = "AC Input Power";
		};
	};
};

&smc_mbox {
	status = "okay";
};

&smc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * ADT /arm-io/qspi/spinor/syscfg reg: <0x0 0x2000>, <0x4000 0x20000>
			 * ("diagnostic-data,format1"): the factory station log ("iPCB"
			 * records) and an erased area.  The per-device calibration (FDR)
			 * is not here; it lives on the NVMe Hardware APFS volume.  Exposed
			 * read-only for diagnostics; nothing may write these ranges.
			 */
			syscfg_hdr: partition@0 {
				label = "syscfg-hdr";
				reg = <0x0 0x2000>;
				read-only;
			};

			syscfg: partition@4000 {
				label = "syscfg";
				reg = <0x4000 0x20000>;
				read-only;
			};

			nvram: partition@24000 {
				label = "nvram";
				reg = <0x24000 0x1d0000>;
			};
		};
	};
};

/*
 * Touch ID: the Mesa fingerprint sensor in the power button (ADT
 * /arm-io/spi2/mesa, "biosensor,mesa", mesaType 1, sensor-id 0x3356, 8 MHz,
 * interrupts [135, 3] on gpio0 = the data-ready line).  Its two rails are not
 * AP GPIOs on the J700: the ADT's function-mesa_pwr1v8 / function-mesa_pwr are
 * pKW8 writes of SMC key "pcLD" through the SMC PMU nub (8-byte payload:
 * u16 on/off, then the rail word 0x01010000 for 1.8 V and 0x01020000 for
 * 3.0 V), so the sensor node names the key and rail words for the SEP driver's
 * SMC power path instead of enable-gpios.  power-on-delay 7 ms / power-off-delay
 * 10 ms are the ADT's.  The calibration blob is this unit's FDR class FSCl
 * (biometrickitd's "FDR" calibration source 3), taken read-only from the
 * Hardware APFS volume of the iBoot system container.
 */
&spi2 {
	status = "okay";

	mesa: fingerprint@0 {
		compatible = "apple,mesa-fingerprint";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-cpol;
		spi-cs-setup-delay-ns = <20>;
		spi-cs-hold-delay-ns = <20>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <135 IRQ_TYPE_EDGE_RISING>;
		apple,smc-power-key = "pcLD";
		apple,smc-power-rails = <0x01010000 0x01020000>;
		firmware-name = "apple/mesacal-j700.bin";
		status = "okay";
	};
};

/*
 * Keep the fixed VL122 out of reset for the complete Linux lifetime.  Its I2C
 * plane NACKs while the USB core is running, so only configure and open the
 * independent TICD2E22 eUSB repeater at address 0x21.
 */
&i2c2 {
	apple,j700-usb-apply-repeater-tunable;
	apple,j700-usb-read-only-diagnostics;
	hub-reset-gpios = <&pinctrl_ap 142 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&dwc3_0 {
	/delete-property/ hub-reset-gpios;
	apple,usb2-hub-always-on;
	status = "okay";

	/*
	 * One fixed VL122 hub fans this DWC3 USB2 link out to both HPMs.  Keep
	 * separate role-switch inputs so either connector can report cable state
	 * without tearing down or stealing the shared always-on host.
	 */
	usb2-role-inputs {
		#address-cells = <1>;
		#size-cells = <0>;

		usb2-role-input@0 {
			reg = <0>;
			usb-role-switch;

			port {
				dwc3_0_hs_rear: endpoint {
					remote-endpoint = <&typec0_connector_hs>;
				};
			};
		};

		usb2-role-input@1 {
			reg = <1>;
			usb-role-switch;

			port {
				dwc3_0_hs_front: endpoint {
					remote-endpoint = <&typec1_connector_hs>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dwc3_0_ss: endpoint {
				remote-endpoint = <&atcphy0_usb3>;
			};
		};
	};
};

/*
 * J700 has one DWC3 and two HPMs.  Both connectors' USB2 signals reach DWC3
 * through the permanently connected VL122 hub, so neither HPM is a USB2 role
 * source: disconnecting either downstream cable must leave the host and hub
 * running.  The rear/DFU-side HPM owns the only direct ATC/SuperSpeed lane;
 * the front connector has no direct ATC endpoint.
 */
&nub_spmi_a0 {
	status = "okay";

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-rear";
			power-role = "dual";
			data-role = "host";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs_rear>;
					};
				};

				port@1 {
					reg = <1>;

					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "host";

			port {
				typec1_connector_hs: endpoint {
					remote-endpoint = <&dwc3_0_hs_front>;
				};
			};
		};
	};
};

&atcphy0 {
	/*
	 * Live J700 ADT tunable_USB2PHY_REG_DFLT.  XNU applies this to ATC
	 * memory region 2 at the end of AppleT8130TypeCPhy::eusb2phy_init().
	 */
	apple,tunable-usb2phy-reg-dflt =
		<0x80 0x000000ff 0x00000017>,
		<0x84 0x000003ff 0x000000c8>,
		<0x88 0x000000ff 0x00000005>,
		<0x8c 0x000003ff 0x00000005>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;

			atcphy0_usb3: endpoint {
				remote-endpoint = <&dwc3_0_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

/*
 * iBoot leaves both SMC I2C domains active.  Powering either one down on
 * J700 causes a delayed SError, so Linux must preserve the inherited state.
 */
&ps_smc_i2cm1 {
	apple,always-on;
};

&ps_smc_i2cm2 {
	apple,always-on;
};

&smc_mbox {
	status = "okay";
};

&smc {
	status = "okay";

	/*
	 * Exactly the six SMC die temperatures the J700 CPU thermal policy samples
	 * (apple-smc-cpu-thermal, cleanroom 0d7db87fa26c): the policy refuses any
	 * other temperature channel set, so keep this list as is.
	 */
	hwmon {
		compatible = "apple,smc-hwmon";
		apple,cpu-thermal-policy;

		temperature-Te05 {
			apple,key-id = "Te05";
			label = "E-cluster Temperature 1";
		};
		temperature-Te0S {
			apple,key-id = "Te0S";
			label = "E-cluster Temperature 2";
		};
		temperature-Tp01 {
			apple,key-id = "Tp01";
			label = "P-cluster Temperature 1";
		};
		temperature-Tp05 {
			apple,key-id = "Tp05";
			label = "P-cluster Temperature 2";
		};
		temperature-Tp09 {
			apple,key-id = "Tp09";
			label = "P-cluster Temperature 3";
		};
		temperature-Tp0D {
			apple,key-id = "Tp0D";
			label = "P-cluster Temperature 4";
		};

		/*
		 * Reporting-only channels.  They must stay after the six policy
		 * die temperatures above, which the CPU thermal policy samples by
		 * position.  Every key here was read back live from the SMC on
		 * this machine and tracks plausibly; the placement implied by
		 * each label follows Apple's SMC key conventions and has not been
		 * cross-checked against macOS.
		 */
		temperature-TB0T {
			apple,key-id = "TB0T";
			label = "Battery";
		};
		temperature-TH0p {
			apple,key-id = "TH0p";
			label = "Storage (NAND)";
		};
		temperature-TW0p {
			apple,key-id = "TW0p";
			label = "Wi-Fi Module";
		};
		temperature-TUCp {
			apple,key-id = "TUCp";
			label = "USB-C Port";
		};
		temperature-TaTp {
			apple,key-id = "TaTp";
			label = "Ambient";
		};
		temperature-TCMz {
			apple,key-id = "TCMz";
			label = "Charger";
		};
		temperature-Ts0A {
			apple,key-id = "Ts0A";
			label = "Chassis 1";
		};
		temperature-Ts0I {
			apple,key-id = "Ts0I";
			label = "Chassis 2";
		};
		temperature-Ts0M {
			apple,key-id = "Ts0M";
			label = "Chassis 3";
		};

		/*
		 * The rest of the SMC's live temperature channels, enumerated from
		 * the firmware's own key table (see smc-keyspace/ in the session
		 * findings): every key here read back in a plausible range and moved
		 * between samples.  Apple's placement for these is unknown, so they
		 * carry the raw key as their label rather than an invented name.
		 */
		temperature-TBLp {
			apple,key-id = "TBLp";
			label = "SMC TBLp";
		};
		temperature-TCMb {
			apple,key-id = "TCMb";
			label = "SMC TCMb";
		};
		temperature-TPD0 {
			apple,key-id = "TPD0";
			label = "SMC TPD0";
		};
		temperature-TPD1 {
			apple,key-id = "TPD1";
			label = "SMC TPD1";
		};
		temperature-TPD2 {
			apple,key-id = "TPD2";
			label = "SMC TPD2";
		};
		temperature-TPD3 {
			apple,key-id = "TPD3";
			label = "SMC TPD3";
		};
		temperature-TPD4 {
			apple,key-id = "TPD4";
			label = "SMC TPD4";
		};
		temperature-TPD5 {
			apple,key-id = "TPD5";
			label = "SMC TPD5";
		};
		temperature-TPD6 {
			apple,key-id = "TPD6";
			label = "SMC TPD6";
		};
		temperature-TR5p {
			apple,key-id = "TR5p";
			label = "SMC TR5p";
		};
		temperature-TRD0 {
			apple,key-id = "TRD0";
			label = "SMC TRD0";
		};
		temperature-TRD1 {
