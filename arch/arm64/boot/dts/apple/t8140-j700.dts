/*
 * Keep U-Boot from owning this transport on T8140.  Its driver explicitly
 * declines the device before touching RTKit; Linux must initialize MTP first.
 */
&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	apple,no-stm;
	apple,afe-reset-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_LOW>;

	multi-touch {
		compatible = "apple,j700-multitouch";
		firmware-name = "apple/tpmtfw-j700.bin";
		apple,power-method = <2>;
	};

	keyboard: keyboard {
		hid-country-code = <33>;
		apple,keyboard-layout-id = <5>;
	};
};

/*
 * PMP: the stopped-epoch owner of the preloaded T8140 PMP firmware and the
 * J700 fast CPU thermal policy (CONFIG_APPLE_PMP_V2_THERMAL).  The own-device
 * metadata the cleanroom bootloader would forward is generated from this
 * machine's ADT into t8140-j700-pmp.dtsi.
 */
&pmp_mbox {
	status = "okay";
};

#include "t8140-j700-pmp.dtsi"

/*
 * FaceTime HD camera: IMX558 behind the ISP17a.  The platform id is the ADT
 * sensor-type (0x70) the macOS 25G83 init passes in the H16 boot descriptor;
 * the newer IMX558 machines run the temporal filter at strength 1.
 */
#include "isp-imx558.dtsi"

&isp {
	apple,platform-id = <0x70>;
	apple,temporal-filter = <1>;
};

/* AOP: the audio fabric owner (low-power microphone first). */
&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "J700";
	apple,machine-kind = "MacBook Neo";
};

&admac_leap_ns {
	status = "okay";
};

&admac_base_ns {
	status = "okay";
};

/*
 * The secure LEAP ADMAC.  It carries the high-quality microphone array's only
 * data path (ADT audio-hp-mic, dma-provider-rx = leap-s-adma-rx-0), and macOS
 * reaches it through the HPMicAudioDriver exclave's proxy aperture at
 * 0x353200000.  With no secure kernel running nothing claims it, and the AOP
 * attaches the array to an ordinary EPIC client, so the host can own the
 * controller directly.
 *
 * Unlike its two siblings this node still has `resets`; if a reset pulse here
 * disturbs the LEAP fabric the way it did for admac_leap_ns, drop the property
 * rather than the node.
 */
&admac_leap_s {
	status = "okay";
};

/*
 * The sound card (macaudio's J700 variant): the 3.5 mm jack (AOP cout/cin
 * services on the audio child's DAI 0 with the CS42L83) and the internal
 * speakers (DAI 4, the LEAP serializer into the MAX98360A amplifiers).
 */
/ {
	sound {
		compatible = "apple,j700-macaudio", "apple,macaudio";
		model = "MacBook Neo J700";

		dai-link@0 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};

		/*
		 * Internal speakers: the AOP's LEAP TX0 (spkr service) into the
		 * MAX98360A, whose SD_MODE the codec driver drives.  The CPU DAI
		 * fixes the digital level at -20 dBFS on the wire.
		 */
		dai-link@1 {
			link-name = "Speaker";

			cpu {
				sound-dai = <&aop_audio 4>;
			};
			codec {
				sound-dai = <&speaker_amp>;
			};
		};
	};
};

/*
 * External display pipe.  Proven on hardware: the coprocessor boots, RTKit
 * handshakes at protocol version 12, the firmware's AFK logging comes up and
 * apple-drm binds it, adding a second connector beside the internal eDP.
 * No external display was attached when this was verified, so what is shown
 * on one has not been exercised.
 */
&dcpext_dart {
	status = "okay";
};

&dispext0_dart {
	status = "okay";
};

&dcpext_mbox {
	status = "okay";
};

&dcpext {
	clocks = <&clk_disp0_154>, <&clk_disp0_194>;
	clock-names = "clock-154", "clock-194";
	apple,iomfb-surfaces = <0>;
	status = "okay";
};
