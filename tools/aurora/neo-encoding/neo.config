# Overlay on arm64 defconfig + the pinned tree's asahi.config.
CONFIG_LOCALVERSION="-aurora-neo"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_RUST=y
CONFIG_DRM=y
CONFIG_DRM_ASAHI=m
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_PCIE_APPLE=y
CONFIG_NVME_APPLE=y
CONFIG_MT7921E=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_LOG_BUF_SHIFT=22
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_FRAME_POINTER=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_WERROR is not set
