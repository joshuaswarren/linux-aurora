[Unit]
Description=Recover Neo KWin after GPU device loss
After=plasma-kwin_x11.service
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_TYPE=x11
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
ExecStart=/usr/local/bin/neo-kwin-device-loss-recovery
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
