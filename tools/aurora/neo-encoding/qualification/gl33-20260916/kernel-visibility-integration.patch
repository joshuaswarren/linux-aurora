+
+/// Whether the routine G17P success-path traces are enabled.
+///
+/// These are the lines emitted for every submission, ring or cursor update,
+/// publication and completion, and for every client graph built or released:
+/// their volume scales with the workload, and a CTS run emits them by the
+/// thousand per minute. Errors, faults, recovery, bounded lifecycle markers
+/// and one-time bring-up logs are never gated on this.
+///
+/// Check it before building a trace's arguments, so that a disabled trace costs
+/// one load. Backed by the runtime-writable `g17p_trace` module parameter.
+#[inline]
+pub(crate) fn g17p_trace() -> bool {
+    crate::G17P_TRACE.load(core::sync::atomic::Ordering::Relaxed)
+}
