+#!/usr/bin/env python3
+"""Compile the real descriptor builder and check native MSAA sample metadata."""
+from pathlib import Path
+import argparse
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--all", action="store_true", help="Run all descriptor-builder regressions")
+args = parser.parse_args()
+source = r'''
+#![allow(dead_code, non_upper_case_globals)]
+mod module_parameters {
+    pub struct Param(u32);
+    impl Param { pub fn value(&self) -> &u32 { &self.0 } }
+    pub static g17p_ta_oracle: Param = Param(0);
+    pub static g17p_frag_oracle: Param = Param(0);
+    pub static g17p_render_ta_qid_field: Param = Param(1);
+}
+mod g17_submission {
+    pub const G17P_NATIVE_RENDER_DOORBELL_PRIORITY: u32 = 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix="g17-render-samples-") as tmp:
+    test = Path(tmp) / "test.rs"
+    test.write_text(source + '#[path = "' + str(root / "g17_render.rs") + '"] mod g17_render;\n')
+    exe = Path(tmp) / "test"
+    subprocess.run(["rustc", "-Awarnings", "--edition=2021", "--test", str(test), "-o", str(exe)], check=True)
+    name = "g17_render::tests::fragment_sample_count_matches_tile_configuration_on_every_submission"
+    listing = subprocess.check_output([str(exe), "--list"], text=True)
+    assert name + ": test" in listing
+    subprocess.run([str(exe)] if args.all else [str(exe), name, "--exact"], check=True)
diff --git a/drivers/gpu/drm/asahi/tests/test_g17_render_sibling_graph_takeover.py b/drivers/gpu/drm/asahi/tests/test_g17_render_sibling_graph_takeover.py
new file mode 100644
index 000000000000..e56451d8bd54
--- /dev/null
+++ b/drivers/gpu/drm/asahi/tests/test_g17_render_sibling_graph_takeover.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""A queue takes over its sibling's cached render graph on the same pair.
+
+A retained graph's RT memory, TPC, TVB and PM mappings live at fixed addresses
+of its VM on its physical pair. When another VM's render parks that graph in the
+handoff cache and a different queue of the first VM then renders on the same
+pair, building a second graph there collides with those mappings: the RT-memory
+allocation returns ENOSPC, the submission fails, and the VM is poisoned. Seen as
+a signal_order watchdog timeout (sched2-extmisc, "persistent render-target-memory
+allocation failed (ENOSPC)").
+
+The queue's own cached graph is still preferred. Failing that, the graph that
+owns the VM's render pool on that pair is reactivated and retargeted to the
+incoming queue's context, exactly as a selected same-VM graph is.
+"""
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+manager = (root / "g17_manager.rs").read_text()
+
+
+def function(source, marker):
+    start = source.index(marker)
+    pos = source.index("{", start) + 1
+    depth = 1
+    while depth:
+        depth += (source[pos] == "{") - (source[pos] == "}")
+        pos += 1
+    return source[start:pos]
+
+
+owner = function(manager, "fn cached_render_graph_owner(")
+assert "[queue, G17PCachedRenderGraphOwner::PairPool]" in owner, \
+    "a sibling graph is chosen over the queue's own graph"
+assert "retired_render_handoff_graph" in owner and "retired_render_handoff_graphs" in owner
+
+matches = function(manager, "fn matches(self, graph: &G17PRetiredRenderGraph")
+assert "graph.storage.queue_pair().slot() == slot" in matches
+assert "retained_graph_matches_owner(graph, vm, context)" in matches
+pool = matches[matches.index("Self::PairPool =>"):]
+assert "graph.bind.matches(vm)" in pool
+assert "vm.render_pool_mappings_match(slot, graph.storage.render_pool_id())" in pool
+assert "descriptor_context_id" not in pool, "the pool owner must not require the same context"
+
+handoff = function(manager, "pub(crate) fn handoff_retained_render_vm(")
+empty = handoff[handoff.index("if self.render_storage.is_none() {"):]
+empty = empty[: empty.index("if !self.retained_render_has_other_owner(")]
+assert "let Some(owner) = owner else {\n                return Ok(());" in empty
+assert empty.index("self.render_storage = Some(cached.storage);") < empty.index(
+    "if owner == G17PCachedRenderGraphOwner::PairPool {"
+)
+assert "return self.retarget_retained_render_graph(vm, execution_context);" in empty
+
+cross = handoff[handoff.index("if !self.retained_render_has_other_owner("):]
+assert "self.cached_render_graph_owner(vm, descriptor_context_id, pair_slot)" in cross
+assert cross.index("self.render_storage = Some(cached.storage);") < cross.index(
+    "if owner == Some(G17PCachedRenderGraphOwner::PairPool) {"
+)
+
+retarget = function(manager, "fn retarget_retained_render_graph(")
+assert retarget.index("self.require_retired_render_owner()?") < retarget.index(
+    ".retarget_command_context(vm, execution_context.clone())"
+)
+
+
+# Model: two pairs, VM 18 queues A (ctx 10) and B (ctx 12), compositor VM 3.
+class Graph:
+    def __init__(self, vm, ctx, pair):
+        self.vm, self.ctx, self.pair = vm, ctx, pair
+
+
+def select(cache, vm, ctx, pair):
+    own = [g for g in cache if g.vm == vm and g.ctx == ctx and g.pair == pair]
+    if own:
+        return own[0], False
+    pool = [g for g in cache if g.vm == vm and g.pair == pair]
+    return (pool[0], True) if pool else (None, False)
+
+
+cache = [Graph(18, 12, 1), Graph(3, 5, 1), Graph(18, 10, 0)]
+graph, retarget_needed = select(cache, 18, 10, 1)
+assert graph is cache[0] and retarget_needed, "queue A must take B's pair-1 graph"
+graph, retarget_needed = select(cache, 18, 12, 1)
+assert graph is cache[0] and not retarget_needed
+graph, retarget_needed = select(cache, 18, 10, 0)
+assert graph is cache[2] and not retarget_needed
+assert select(cache, 7, 1, 1) == (None, False), "a VM with no pool builds a fresh graph"
+
+print("render sibling graph takeover: OK")
