+    pub(crate) fn write(&self, ticks: u64) -> Result {
+        const NSEC_PER_SEC: u64 = 1_000_000_000;
+        let timestamp = ticks / G17P_COMMAND_TIMESTAMP_HZ * NSEC_PER_SEC
