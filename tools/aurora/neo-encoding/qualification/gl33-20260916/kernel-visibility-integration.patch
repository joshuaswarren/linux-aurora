+    #[test]
+    fn render_item_window_admits_only_this_graphs_records() {
+        use G17PRenderItemWindowFault as Fault;
+        const GRAPH: u64 = 0xffff_fc20_c070_0000;
+        const DESCRIPTORS: (u64, u64) = (0xffff_fc20_0100_0000, 0xffff_fc20_0105_0000);
+        let group = |values: &[u64]| {
+            let mut bytes = vec![0u8; values.len() * 8];
+            for (index, value) in values.iter().enumerate() {
+                put_u64(&mut bytes, index * 8, *value);
+            }
+            bytes
+        };
+        let valid = [DESCRIPTORS.0 + 0x100, GRAPH + 0xc000, GRAPH + 0xf000];
+
+        for ordinal in [5, 426] {
+            let plan = G17PRenderItemPlan::new(ordinal, false).unwrap();
+            let window = G17PRenderItemWindow {
+                graph_va: GRAPH,
+                record: 0,
+                pointers: G17P_USER_TILING_POINTERS,
+                ring: G17P_USER_TILING_RING,
+                descriptors: DESCRIPTORS,
+                plan,
+                first_item: 0,
+            };
+            let mut graph = vec![0u8; 0x14000];
+            put_u64(&mut graph, 0, GRAPH + G17P_USER_TILING_POINTERS as u64);
+            put_u64(&mut graph, 8, GRAPH + G17P_USER_TILING_RING as u64);
+            put_u32(&mut graph, G17P_USER_TILING_POINTERS + 0x60, 0x500);
+            for cursor in [0, 0x30, 0x40] {
+                put_u32(&mut graph, G17P_USER_TILING_POINTERS + cursor, plan.base);
+            }
+            assert_eq!(window.check(&graph, &group(&valid)), Ok(()));
+
+            for (index, value) in [(0, 8), (1, GRAPH + 0x14000 - 8), (2, GRAPH + 0xc001), (0, 0)] {
+                let mut items = valid;
+                items[index] = value;
+                assert_eq!(
+                    window.check(&graph, &group(&items)),
+                    Err(Fault::Item { slot: (plan.base + index as u32) % 0x500, value }),
+                );
+            }
+
+            let mut wrong = graph.clone();
+            put_u64(&mut wrong, 8, GRAPH + G17P_USER_TILING_RING as u64 + 8);
+            assert_eq!(
+                window.check(&wrong, &group(&valid)),
+                Err(Fault::RecordRing(GRAPH + G17P_USER_TILING_RING as u64 + 8)),
+            );
+            let mut wrong = graph.clone();
+            put_u32(&mut wrong, G17P_USER_TILING_POINTERS + 0x60, 0x400);
+            assert_eq!(window.check(&wrong, &group(&valid)), Err(Fault::Capacity(0x400)));
+            let mut wrong = graph.clone();
+            put_u32(&mut wrong, G17P_USER_TILING_POINTERS + 0x40, plan.final_end);
+            assert_eq!(window.check(&wrong, &group(&valid)), Err(Fault::Producer(plan.final_end)));
+            let behind = (plan.base + 0x500 - 1) % 0x500;
+            let mut wrong = graph.clone();
+            put_u32(&mut wrong, G17P_USER_TILING_POINTERS, behind);
+            assert_eq!(
+                window.check(&wrong, &group(&valid)),
+                Err(Fault::Consumer { done: behind, read: plan.base }),
+            );
+
+            // The kick half also covers the published prefix firmware has not
+            // consumed yet, and nothing it already has.
+            let kick = G17PRenderItemWindow { first_item: 2, ..window };
+            let mut staged = graph.clone();
+            plan.copy_items(&mut staged, G17P_USER_TILING_RING, 0, &group(&valid[..2])).unwrap();
+            put_u32(&mut staged, G17P_USER_TILING_POINTERS + 0x40, plan.prefix_end);
+            assert_eq!(kick.check(&staged, &group(&valid[2..])), Ok(()));
+            let second = (plan.base + 1) % 0x500;
+            put_u64(&mut staged, G17P_USER_TILING_RING + second as usize * 8, 8);
+            assert_eq!(
+                kick.check(&staged, &group(&valid[2..])),
+                Err(Fault::Item { slot: second, value: 8 }),
+            );
+            for cursor in [0, 0x30] {
+                put_u32(&mut staged, G17P_USER_TILING_POINTERS + cursor, plan.prefix_end);
+            }
+            assert_eq!(kick.check(&staged, &group(&valid[2..])), Ok(()));
+            assert_eq!(kick.check(&staged, &group(&valid)), Err(Fault::Bounds));
+        }
+    }
