+/// Why a render item window may not be exposed to firmware.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+enum G17PRenderItemWindowFault {
+    Bounds,
+    RecordPointers(u64),
+    RecordRing(u64),
+    Capacity(u32),
+    Producer(u32),
+    Consumer { done: u32, read: u32 },
+    Item { slot: u32, value: u64 },
+}
+
+/// The item window firmware executes for one queue of a render graph.
+///
+/// Firmware runs a queue record's item ring from the queue's consumer up to
+/// the write index its outer data-master entry names, and dispatches every
+/// slot as a channel record without checking it. Before the group's items and
+/// producer become visible, the record must still name this graph's pointer
+/// block and ring, the cursors must sit inside this group, and every slot
+/// from the consumer to the group's last item must name one of this graph's
+/// records or descriptors.
+#[derive(Debug, Copy, Clone)]
+struct G17PRenderItemWindow {
+    graph_va: u64,
+    record: usize,
+    pointers: usize,
+    ring: usize,
+    descriptors: (u64, u64),
+    plan: G17PRenderItemPlan,
+    first_item: u32,
+}
+
+impl G17PRenderItemWindow {
+    /// Smallest extent a channel record's dispatch reads.
+    const RECORD_HEADER: u64 = 0x10;
+
+    fn check(&self, graph: &[u8], items: &[u8]) -> core::result::Result<(), G17PRenderItemWindowFault> {
+        use G17PRenderItemWindowFault as Fault;
+
+        let u32_at = |offset: usize| -> core::result::Result<u32, Fault> {
+            graph
+                .get(offset..offset.checked_add(4).ok_or(Fault::Bounds)?)
+                .and_then(|bytes| bytes.try_into().ok())
+                .map(u32::from_le_bytes)
+                .ok_or(Fault::Bounds)
+        };
+        let u64_at = |offset: usize| -> core::result::Result<u64, Fault> {
+            graph
+                .get(offset..offset.checked_add(8).ok_or(Fault::Bounds)?)
+                .and_then(|bytes| bytes.try_into().ok())
+                .map(u64::from_le_bytes)
+                .ok_or(Fault::Bounds)
+        };
+        let item_count = u32::try_from(items.len() / 8).map_err(|_| Fault::Bounds)?;
+        if items.len() % 8 != 0 || self.first_item.checked_add(item_count).ok_or(Fault::Bounds)? > self.plan.count {
+            return Err(Fault::Bounds);
+        }
+
+        let record_pointers = u64_at(self.record)?;
+        if Some(record_pointers) != self.graph_va.checked_add(self.pointers as u64) {
+            return Err(Fault::RecordPointers(record_pointers));
+        }
+        let record_ring = u64_at(self.record + 8)?;
+        if Some(record_ring) != self.graph_va.checked_add(self.ring as u64) {
+            return Err(Fault::RecordRing(record_ring));
+        }
+        let capacity = u32_at(self.pointers + 0x60)?;
+        if capacity != self.plan.capacity {
+            return Err(Fault::Capacity(capacity));
+        }
+
+        let done = u32_at(self.pointers)?;
+        let read = u32_at(self.pointers + 0x30)?;
+        let write = u32_at(self.pointers + 0x40)?;
+        let distance = |cursor: u32| (cursor + capacity - self.plan.base) % capacity;
+        let expected_write = (self.plan.base + self.first_item) % capacity;
+        if write != expected_write {
+            return Err(Fault::Producer(write));
+        }
+        if done >= capacity
+            || read >= capacity
+            || distance(done) > distance(read)
+            || distance(read) > self.first_item
+        {
+            return Err(Fault::Consumer { done, read });
+        }
+
+        let valid = |value: u64| {
+            let inside = |(start, end): (u64, u64)| {
+                value >= start
+                    && value.checked_add(Self::RECORD_HEADER).is_some_and(|last| last <= end)
+            };
+            value & 7 == 0
+                && (inside((self.graph_va, self.graph_va + graph.len() as u64))
+                    || inside(self.descriptors))
+        };
+        for index in distance(done)..self.first_item + item_count {
+            let slot = (self.plan.base + index) % capacity;
+            let value = if index < self.first_item {
+                u64_at(self.ring + slot as usize * 8)?
+            } else {
+                let at = (index - self.first_item) as usize * 8;
+                u64::from_le_bytes(items[at..at + 8].try_into().map_err(|_| Fault::Bounds)?)
+            };
+            if !valid(value) {
+                return Err(Fault::Item { slot, value });
+            }
+        }
+        Ok(())
+    }
+}
