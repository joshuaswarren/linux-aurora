+    match = re.search(pattern, source, re.M)
+    assert match, pattern
+    start = match.start()
+    at = source.index("{", match.end())
+    depth = 1
+    end = at + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
