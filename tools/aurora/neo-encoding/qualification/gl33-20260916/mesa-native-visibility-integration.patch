+      nir_def *page_in_range = nir_ult(b, page, nir_u2u64(b, page_count));
+      nir_def *valid_map = nir_iand(b, has_map, page_in_range);
+      nir_def *word = nir_ushr_imm(b, page, 5);
+      nir_def *map_addr = nir_iadd_imm(
