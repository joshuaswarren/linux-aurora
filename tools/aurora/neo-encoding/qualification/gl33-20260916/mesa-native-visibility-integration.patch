diff --git a/src/asahi/vulkan/tests/test-hk-cdm-inline-merge.c b/src/asahi/vulkan/tests/test-hk-cdm-inline-merge.c
new file mode 100644
index 00000000000..3c387afaa76
--- /dev/null
+++ b/src/asahi/vulkan/tests/test-hk-cdm-inline-merge.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: MIT */
+#include "../hk_cmd_buffer.h"
+#include "asahi/genxml/agx3_cmdstream.h"
+
+#include <assert.h>
+#include <stdio.h>
+
+static unsigned jump_calls;
+
+void *
+hk_cmd_buffer_emit_cs_jump(UNUSED struct hk_cmd_buffer *cmd, void *current,
+                           UNUSED uint64_t target, UNUSED bool vdm)
+{
+   jump_calls++;
+   return current;
+}
+
+int
+main(void)
+{
+   /* Adjacent compute roots are assembled independently while recording.
+    * When their used prefixes fit in one root, merging must concatenate the
+    * bytes instead of inserting a CDM stream link. The kernel's compute ABI
+    * points at end - 4 as the terminator, so a linked small stream would make
+    * that pointer name unused root padding rather than the real terminator. */
+   static uint8_t a_root[HK_CS_ROOT_SIZE];
+   static uint8_t b_root[HK_CS_ROOT_SIZE];
+   memset(a_root, 0xa5, sizeof(a_root));
+   memset(b_root, 0x5a, sizeof(b_root));
+
+   struct hk_cmd_buffer cmd = {0};
+   struct hk_cs a = {
+      .cmd = &cmd,
+      .type = HK_CS_CDM,
+      .addr = 0x100000,
+      .start = a_root,
+      .current = a_root + 12,
+      .end = a_root + sizeof(a_root),
+      .chunk = {.cpu = a_root, .gpu = 0x100000},
+      .stats = {.cmds = 1},
+   };
+   struct hk_cs b = {
+      .cmd = &cmd,
+      .type = HK_CS_CDM,
+      .addr = 0x200000,
+      .start = b_root,
+      .current = b_root + 84,
+      .end = b_root + sizeof(b_root),
+      .chunk = {.cpu = b_root, .gpu = 0x200000},
+      .strong_flush_end = b_root + 44,
+      .weak_barrier_end = b_root + 84,
+      .stats = {.cmds = 2},
+   };
+
+   hk_cs_merge_cdm(&a, &b);
+   assert(jump_calls == 0);
+   assert(!a.stream_linked);
+   assert(a.current == a_root + 96);
+   assert(a.end == a_root + sizeof(a_root));
+   assert(a.chunk.cpu == a_root && a.chunk.gpu == 0x100000);
+   assert(!memcmp(a_root + 12, b_root, 84));
+   assert(a.strong_flush_end == a_root + 56);
+   assert(a.weak_barrier_end == a_root + 96);
+   assert(a.stats.cmds == 3 && a.stats.merged == 1);
+
+   uint8_t terminate[AGX3_CDM_STREAM_TERMINATE_SIZE];
+   assert(agx3_cdm_stream_terminate_pack(AGX_CHIP_G17P, terminate));
+   memcpy(a.current, terminate, sizeof(terminate));
+   a.current = (uint8_t *)a.current + sizeof(terminate);
+   const size_t submitted_len = (uint8_t *)a.current - (uint8_t *)a.start;
+   assert(submitted_len == 100);
+   assert(agx3_cdm_stream_terminate_validate(
+      AGX_CHIP_G17P, a_root + submitted_len - sizeof(terminate),
+      sizeof(terminate)));
+
+   /* Merging a HOST_READ-only root must neither duplicate the preceding
+    * cache flush nor leave an adjacent weak barrier before a strong one. */
+   for (unsigned strong = 0; strong < 2; ++strong) {
+      uint8_t tail[16] = {0}, flush[AGX3_CDM_BARRIER_SIZE];
+      struct agx3_cdm_barrier_info info = {
+         .chip = AGX_CHIP_G17P, .flags = strong ? 5 : 0,
+      };
+      assert(agx3_cdm_barrier_pack(&info, tail + 8));
+      info.flags = 5;
+      assert(agx3_cdm_barrier_pack(&info, flush));
+      struct hk_cs preceding = {
+         .cmd = &cmd, .type = HK_CS_CDM,
+         .start = tail, .current = tail + 12, .end = tail + sizeof(tail),
+         .strong_flush_end = strong ? tail + 12 : NULL,
+         .weak_barrier_end = strong ? NULL : tail + 12,
+         .stats = {.cmds = 1, .flushes = strong},
+      };
+      const struct hk_cs host_read = {
+         .cmd = &cmd, .type = HK_CS_CDM,
+         .start = flush, .current = flush + sizeof(flush),
+         .end = flush + sizeof(flush),
+         .strong_flush_end = flush + sizeof(flush),
+         .stats = {.flushes = 1},
+      };
+      hk_cs_merge_cdm(&preceding, &host_read);
+      assert(preceding.current == tail + 12);
+      assert(!memcmp(tail + 8, flush, sizeof(flush)));
+      assert(preceding.strong_flush_end == tail + 12);
+      assert(preceding.weak_barrier_end == NULL);
+      assert(preceding.stats.cmds == 1 && preceding.stats.flushes == 1);
+      assert(preceding.stats.merged == 1 && jump_calls == 0);
+   }
+
+   /* A host-read prologue can have later work in the same root. Consume
+    * only the flush, retain every following byte, and rebase both markers. */
+   uint8_t prefix[HK_CS_ROOT_SIZE] = {0}, following[16];
+   memset(following, 0x5a, sizeof(following));
+   struct agx3_cdm_barrier_info weak = {.chip = AGX_CHIP_G17P};
+   struct agx3_cdm_barrier_info strong = {.chip = AGX_CHIP_G17P, .flags = 5};
+   assert(agx3_cdm_barrier_pack(&weak, prefix + 8));
+   assert(agx3_cdm_barrier_pack(&strong, following));
+   assert(agx3_cdm_barrier_pack(&weak, following + 12));
+   struct hk_cs first = {
+      .cmd = &cmd, .type = HK_CS_CDM,
+      .start = prefix, .current = prefix + 12, .end = prefix + sizeof(prefix),
+      .weak_barrier_end = prefix + 12, .stats = {.cmds = 1},
+   };
+   const struct hk_cs next = {
+      .cmd = &cmd, .type = HK_CS_CDM,
+      .start = following, .current = following + sizeof(following),
+      .end = following + sizeof(following),
+      .strong_flush_end = following + 4, .weak_barrier_end = following + 16,
+      .stats = {.cmds = 1, .flushes = 1},
+   };
+   hk_cs_merge_cdm(&first, &next);
+   assert(first.current == prefix + 24);
+   assert(!memcmp(prefix + 8, following, sizeof(following)));
+   assert(first.strong_flush_end == prefix + 12);
+   assert(first.weak_barrier_end == prefix + 24);
+   assert(first.stats.cmds == 2 && first.stats.flushes == 1);
+   assert(jump_calls == 0);
+
+   puts("G17P inline CDM merge, host-read flush and terminal pointer PASS");
+   return 0;
+}
