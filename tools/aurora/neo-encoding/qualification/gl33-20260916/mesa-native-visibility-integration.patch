+      const struct agx3_sr_desc d = {
+         .dest = sr_dest,
+         .width = AGX3_SR_W16,
+         .sr = 39,
+         .slot = 1,
+         .first = true,
+      };
+      uint8_t sr[AGX3_SR_MAX_LENGTH];
+      uint8_t sr_length = 0;
+      if (!agx3_sr_encode(AGX_ISA_ENCODING_AGX3B, &d, sr, &sr_length) ||
+          sr_length + 8 > size || memcmp(code, sr, sr_length))
+         continue;
