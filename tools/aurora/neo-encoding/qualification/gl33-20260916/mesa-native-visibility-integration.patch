+   if (!out || !info || chip != AGX_CHIP_G17P ||
+       info->factor_buffer >= (UINT64_C(1) << 48) ||
+       info->indirect_buffer >= (UINT64_C(1) << 48) ||
+       (info->indirect_buffer & 3) ||
+       info->instance_stride_word > AGX_VDM_TESSELLATE_INSTANCE_STRIDE_MAX)
+      return false;
