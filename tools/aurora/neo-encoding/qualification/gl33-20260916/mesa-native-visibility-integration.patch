+bool
+agx_vdm_tessellate_indirect_pack(
+   enum agx_chip chip, const struct agx_vdm_tessellate_indirect_info *info,
+   struct agx_vdm_tessellate_indirect *out)
+{
+   if (out)
+      memset(out, 0, sizeof(*out));
