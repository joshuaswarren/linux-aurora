#!/bin/sh
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
echo AURORA_J873_LINUX_INITRAMFS_READY
uname -a
cat /proc/cmdline
if ! tr '\000' '\n' < /proc/device-tree/compatible | grep -qx apple,j873; then
    echo J873_IDENTITY_MISMATCH
else
    # Powersave starts at the lowest firmware request. Preserve that cap.
    if modprobe apple-soc-cpufreq; then
        for p in /sys/devices/system/cpu/cpufreq/policy*; do
            [ -d "$p" ] || continue
            low=$(cat "$p/cpuinfo_min_freq")
            echo "$low" > "$p/scaling_max_freq"
            echo powersave > "$p/scaling_governor"
        done
    else
        echo J873_CPUFREQ_PROBE_FAILED
    fi
    if modprobe macsmc && modprobe macsmc-hwmon; then
        /opt/j873/thermal-status.sh | tee /dev/tty1
    else
        echo J873_SMC_PROBE_FAILED
    fi
fi
echo 'J873 RAM thermal shell on DockChannel; verify cooling for this boot.' | tee /dev/tty1
while :; do
    setsid cttyhack /bin/sh
done
