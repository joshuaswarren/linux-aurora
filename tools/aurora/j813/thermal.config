# Temperature monitoring and CPU frequency cooling for the J813 candidate.
# Userspace keeps the firmware's initial clock until explicitly qualified.
CONFIG_HWMON=y
CONFIG_MFD_MACSMC=m
CONFIG_SENSORS_MACSMC_HWMON=m
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=m
CONFIG_CPU_IDLE=y
