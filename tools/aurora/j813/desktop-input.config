# Opt-in J813 MTP input, with private device-extracted multitouch firmware.
CONFIG_LOCALVERSION="-aurora-j813-desktop-v7"
CONFIG_PM=y
CONFIG_APPLE_MAILBOX=m
CONFIG_APPLE_RTKIT=m
CONFIG_APPLE_RTKIT_HELPER=m
CONFIG_APPLE_DOCKCHANNEL=m
CONFIG_HID_DOCKCHANNEL=m
CONFIG_HID_MAGICMOUSE=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_PWM=y
CONFIG_PWM_APPLE=y
CONFIG_LEDS_PWM=y
# leds-pwm performs a GPIO lookup even when enable-gpios is absent.
CONFIG_GPIOLIB=y
CONFIG_HID_APPLE=m
